# Root env. Two consumers:
#
# 1. Development — the Prisma CLI and Turborepo read the connection strings
#    below. `yarn setup` writes this for you.
#
# Local Docker Postgres (see docker-compose.yml):
DATABASE_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"
DIRECT_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"

# 2. Self-hosting — `docker compose up -d` reads the settings below from this
#    file. Every one is optional: with none set you get the whole app on
#    http://localhost:3000, local email + password accounts, images on a
#    Docker volume, and no AI. See docs/self-hosting.md.
#
# Where browsers reach the app. Change both for a LAN/public install, then
# `docker compose up -d --build` (the API URL is compiled into the web app).
# PUBLIC_WEB_URL="http://localhost:3000"
# PUBLIC_API_URL="http://localhost:3001"
#
# Generated on first boot when unset (kept in the buzrr-secrets volume).
# BETTER_AUTH_SECRET=""
#
# Sign-in. Local accounts are on; close self-registration once your users
# exist. Google is added when both credentials are set.
# AUTH_EMAIL_SIGNUP="OFF"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
#
# Question images: local (default) | cloudinary | s3 — the CLOUDINARY_* / S3_*
# settings are listed in apps/server/.env.example.
# STORAGE_DRIVER="local"
#
# AI quiz generation and Knowledge Spaces (`--profile ai`). Gemini:
# GEMINI_API_KEY=""
# …or any OpenAI-compatible server, e.g. the bundled `--profile ollama`:
# LLM_BASE_URL="http://ollama:11434/v1"
# LLM_MODEL="llama3.1"
# AI_GENERATION_MODEL="llama3.1"
# AI_EMBEDDING_MODEL="nomic-embed-text"
# PUBLIC_AI_API_URL="http://localhost:3002"   # show Knowledge Spaces in the UI
