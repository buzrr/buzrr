# Copy to `.env` on the EC2 host (same directory as docker-compose.yml) and fill
# in. Never commit the real file. Full reference: apps/server/.env.example.

# Public hostname Caddy serves and gets a certificate for. Its DNS A record
# must point at this instance before the first start.
API_DOMAIN=api.example.com

# Browser origin(s) allowed by CORS — the Vercel web app. Comma-separated.
WEB_ORIGIN=https://example.com

# Must be identical to BETTER_AUTH_SECRET in Vercel.
BETTER_AUTH_SECRET=

# External Postgres (needs the pgvector extension). DIRECT_URL is the
# non-pooled URL migrations use; same as DATABASE_URL if you have no pooler.
DATABASE_URL=postgresql://user:pass@host:5432/buzrr?sslmode=require
DIRECT_URL=postgresql://user:pass@host:5432/buzrr?sslmode=require

# External Redis (e.g. Upstash: rediss://default:<token>@<host>:6379).
REDIS_URL=

# AI quiz generation.
GEMINI_API_KEY=

# Question images — Cloudinary, or STORAGE_DRIVER=s3 with S3_*.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (Upstash REST).
# RATELIMIT=ON
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Buzrr Pro billing. With BILLING=ON every value below is required.
# BILLING=ON
# DODO_PAYMENTS_ENVIRONMENT=live_mode
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_PRO_PRODUCT_ID=
# APP_URL=https://example.com
