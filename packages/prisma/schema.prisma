generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  providerId            String    @map("provider")
  accountId             String    @map("provider_account_id")
  refreshToken          String?   @map("refresh_token")
  accessToken           String?   @map("access_token")
  scope                 String?
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  password              String?
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @map("session_token")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  image               String?
  password            String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  emailVerified       Boolean              @default(false) @map("email_verified")
  eloRating           Int                  @default(1200) @map("elo_rating")
  duelsPlayed         Int                  @default(0) @map("duels_played")
  /// Manual per-user room-size override. The effective cap is
  /// max(plan cap, hostSizeLimit) — see billing/entitlements.service.ts.
  hostSizeLimit       Int                  @default(50) @map("host_size_limit")
  role                Role                 @default(user)
  /// `userPreferencesSchema` in @buzrr/contract: default logo / audio skin /
  /// avatar skin, own avatar pictures.
  preferences         Json                 @default("{}")
  /// Dodo Payments customer, set by the first verified billing webhook.
  dodoCustomerId      String?              @unique @map("dodo_customer_id")
  /// Lifetime Free-plan AI generations spent (never refills).
  freeAiTokensUsed    Int                  @default(0) @map("free_ai_tokens_used")
  /// Pro AI generations spent in the rolling 7-day window starting at
  /// `proAiWindowStart`; the window resets lazily on the next reservation.
  proAiTokensUsed     Int                  @default(0) @map("pro_ai_tokens_used")
  proAiWindowStart    DateTime?            @map("pro_ai_window_start")
  /// IANA zone reported by the browser; decides what "today" means for the
  /// daily duel streak. Null falls back to UTC.
  timeZone            String?              @map("time_zone")
  /// Daily duel streak. `currentStreak` is only meaningful while
  /// `lastStreakDay` is today or yesterday in `timeZone` — readers decay it
  /// (common/utils/daily-streak.ts `effectiveStreak`).
  currentStreak       Int                  @default(0) @map("current_streak")
  bestStreak          Int                  @default(0) @map("best_streak")
  lastStreakDay       DateTime?            @map("last_streak_day") @db.Date
  hostedResults       GameResult[]
  GameSessions        GameSession[]
  quizzes             Quiz[]
  accounts            Account[]
  sessions            Session[]
  reportedQuestions   QuestionReport[]
  subscriptions       Subscription[]
  payments            Payment[]
  aiTokenReservations AiTokenReservation[]
  questions           Question[]
  categoryRatings     UserCategoryRating[]
  duelDays            DuelDay[]
  soundSkins          SoundSkin[]

  @@index([role])
  @@map("users")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  created_at DateTime? @default(now())
  updated_at DateTime?
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Quiz {
  id           String        @id @default(cuid())
  title        String
  description  String?
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  thumbnail    String?
  /// The quiz's own logo (an upload URL), shown on its game screens instead
  /// of the site logo.
  logo         String?
  /// Public quizzes feed the duel-mode question pool.
  isPublic     Boolean       @default(false)
  /// Quiz settings (`quizSettingsSchema` in @buzrr/contract), e.g. moderated mode.
  settings     Json          @default("{}")
  gameResults  GameResult[]
  gameSessions GameSession[]
  questions    Question[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id               String             @id @default(cuid())
  title            String
  /// Question type key, e.g. "multiple_choice". A plain string rather than an
  /// enum on purpose: types are registered in code (one handler per type in
  /// apps/server/src/modules/question-types), so a new type needs no migration.
  /// Unknown values are rejected by the handler registry, not the database.
  type             String             @default("multiple_choice")
  /// Type-specific settings, validated by the type's handler on every write.
  config           Json               @default("{}")
  /// Null for a standalone question (no quiz) — e.g. bulk-uploaded pool
  /// content. Standalone questions reach players only through the duel pool.
  quizId           String?
  /// Author; the ownership check for edits. Backfilled from `Quiz.userId`.
  createdById      String?
  createdAt        DateTime           @default(now())
  timeOut          Int                @default(15)
  media            String?
  mediaType        String?
  /// Optional sound (MP3) played on the host screen: from `audioStartMs` for
  /// the question's time while it is open, from `audioRevealMs` at the reveal.
  audio            String?
  audioStartMs     Int?
  audioRevealMs    Int?
  /// Where the sound plays: null = like the quiz's sound setting, otherwise
  /// "host" | "players" | "both" | "off".
  audioPlayOn      String?
  /// What devices actually load: the two played windows cut from `audio`
  /// (mono, 96 kbit/s), each AES-256-GCM encrypted with its own key. The
  /// question key goes out with `question-start`, the reveal key with the
  /// reveal, so a clip can be preloaded early without being playable early.
  audioClip        String?
  audioClipKey     String?
  audioRevealClip  String?
  audioRevealKey   String?
  /// The picture as devices load it ahead of time: AES-256-GCM encrypted,
  /// the key goes out with `question-start` (images only).
  mediaClip        String?
  mediaKey         String?
  order            Int                @default(1)
  /// Kept in the quiz, but skipped in games, question counts and scoring.
  disabled         Boolean            @default(false)
  /// Per-question moderation gate for the duel pool; the quiz's `isPublic`
  /// flag alone no longer decides eligibility.
  moderationStatus ModerationStatus   @default(draft)
  reportCount      Int                @default(0)
  options          Option[]
  reports          QuestionReport[]
  categories       QuestionCategory[]
  quiz             Quiz?              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdBy        User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([moderationStatus, reportCount])
  @@index([createdById])
}

/// A duel topic. A question belongs to zero or more categories; each
/// category has its own duel rating per user.
model Category {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  /// OKLCH hue (0–360) for the category swatch.
  hue       Int                  @default(270)
  createdAt DateTime             @default(now())
  questions QuestionCategory[]
  ratings   UserCategoryRating[]
  results   GameResult[]
}

model QuestionCategory {
  questionId String
  categoryId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([questionId, categoryId])
  @@index([categoryId])
}

/// Per-category duel rating. "Random" duels keep using `User.eloRating`.
model UserCategoryRating {
  userId      String
  categoryId  String
  rating      Int      @default(1200)
  duelsPlayed Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

/// One row per local calendar day on which the user finished a duel; feeds
/// the streak calendar.
model DuelDay {
  userId String
  day    DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model Option {
  id         String   @id @default(cuid())
  title      String
  isCorrect  Boolean
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

/// A player flagging an approved question as wrong/NSFW. Distinct reporters
/// are counted toward the auto-unapprove threshold in moderation.service.ts.
model QuestionReport {
  id             String   @id @default(cuid())
  questionId     String
  reporterUserId String
  createdAt      DateTime @default(now())
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reporterUser   User     @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([questionId, reporterUserId])
}

model Player {
  id         String       @id @default(cuid())
  name       String
  gameId     String?
  createdAt  DateTime     @default(now())
  profilePic String?
  game       GameSession? @relation(fields: [gameId], references: [id])
}

/// Lobby record for a classic room. Live gameplay state (phase, question
/// index, scores) lives in Redis and is owned by the game engine — the only
/// gameplay flag kept here is `isPlaying`, which join checks read to tell a
/// waiting lobby from a room already in progress.
model GameSession {
  id        String   @id @default(cuid())
  quizId    String
  creatorId String
  gameCode  String   @unique
  isPlaying Boolean  @default(false)
  /// This game's settings (`quizSettingsSchema`), chosen by the host when
  /// opening the room; null = the quiz's. Read through `roomSettings`
  /// (apps/server/src/common/game-look).
  settings  Json?
  createdAt DateTime @default(now())
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  players   Player[]
}

/// Immutable record of a finished game. Live state lives in Redis during
/// play; this (plus its entries) is the only thing that survives a game.
model GameResult {
  id            String            @id @default(cuid())
  gameCode      String
  mode          GameMode          @default(classic)
  quizId        String?
  quizTitle     String
  hostId        String?
  playerCount   Int
  questionCount Int
  startedAt     DateTime
  endedAt       DateTime          @default(now())
  /// Duel category; null for classic games and Random duels.
  categoryId    String?
  host          User?             @relation(fields: [hostId], references: [id])
  quiz          Quiz?             @relation(fields: [quizId], references: [id])
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  entries       GameResultEntry[]

  @@index([hostId])
  @@index([quizId])
  @@index([categoryId])
}

model GameResultEntry {
  id           String       @id @default(cuid())
  gameResultId String
  /// Snapshot — players are ephemeral rows that don't survive the game.
  playerName   String
  profilePic   String?
  /// Set for logged-in (duel) participants.
  userId       String?
  score        Int
  rank         Int
  correctCount Int
  eloBefore    Int?
  eloAfter     Int?
  /// Duel outcome for this participant; null for classic games.
  outcome      DuelOutcome?
  result       GameResult   @relation(fields: [gameResultId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Mirror of a Dodo Payments subscription. Written only by verified webhooks or
/// server-side Dodo fetches (billing-webhook.service.ts) — never by client
/// input. Plan entitlements are derived from these rows on every check.
model Subscription {
  id                 String             @id @default(cuid())
  userId             String?            @map("user_id")
  dodoSubscriptionId String             @unique @map("dodo_subscription_id")
  dodoCustomerId     String             @map("dodo_customer_id")
  productId          String             @map("product_id")
  status             SubscriptionStatus
  currency           String
  recurringAmount    Int                @map("recurring_amount")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  lastSyncedAt       DateTime           @default(now()) @map("last_synced_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([dodoCustomerId])
  @@map("subscriptions")
}

/// Idempotency ledger for Dodo webhooks, keyed by the `webhook-id` header.
/// The claim is inserted in the same transaction as the event's effects.
model BillingEvent {
  webhookId  String   @id @map("webhook_id")
  type       String
  objectId   String?  @map("object_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("billing_events")
}

/// Audit trail of Dodo payments seen via webhooks.
model Payment {
  id                 String   @id @default(cuid())
  dodoPaymentId      String   @unique @map("dodo_payment_id")
  userId             String?  @map("user_id")
  dodoSubscriptionId String?  @map("dodo_subscription_id")
  status             String
  amount             Int
  currency           String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("payments")
}

/// One AI generation's token spend. Refundable once (via its hashed release
/// token) if the generation fails; otherwise it simply stays consumed.
model AiTokenReservation {
  id               String                   @id @default(cuid())
  userId           String                   @map("user_id")
  source           AiTokenSource
  bucket           AiTokenBucket
  /// The Pro window the token came from — a refund never lands in a newer one.
  windowStart      DateTime?                @map("window_start")
  status           AiTokenReservationStatus @default(consumed)
  releaseTokenHash String                   @map("release_token_hash")
  createdAt        DateTime                 @default(now()) @map("created_at")
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_token_reservations")
}

/// Mirrors Dodo's `SubscriptionStatus`. Only `active` (and a still-paid-for
/// cancel-at-period-end `cancelled`) grants Pro — see isProSubscription().
enum SubscriptionStatus {
  pending
  active
  on_hold
  paused
  past_due
  cancelled
  failed
  expired
}

enum AiTokenSource {
  quiz_ai
  rag
}

enum AiTokenBucket {
  free
  pro
}

enum AiTokenReservationStatus {
  consumed
  refunded
}

enum DuelOutcome {
  win
  loss
  draw
}

enum GameMode {
  classic
  duel
}

enum Role {
  user
  admin
  superadmin
}

enum ModerationStatus {
  draft
  pending
  approved
  unapproved
}

/// A set of game sounds (an uploaded MP3 per moment: lobby, countdown,
/// question, end, reveal, scores, final). Built-in skins are synthesized in
/// the browser and have no row. Global skins are offered to every user.
model SoundSkin {
  id          String   @id @default(cuid())
  name        String
  userId      String?  @map("user_id")
  isGlobal    Boolean  @default(false) @map("is_global")
  /// slot -> uploaded MP3 URL (`soundSlotSchema`), full quality (the host)
  slots       Json     @default("{}")
  /// slot -> the same, small (mono, 64 kbit/s), what players' devices load
  playerSlots Json     @default("{}") @map("player_slots")
  /// The final song as devices load it ahead of time: encrypted
  /// ({ url, key }); the key goes out only with the final leaderboard.
  finalClip   Json?    @map("final_clip")
  /// slot -> playback options (`soundSlotOptionsSchema`)
  options     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sound_skins")
}

/// Playback options of a built-in (synthesized) skin, for everyone; only the
/// superadmin changes them.
model BuiltinSoundOptions {
  skinId      String   @id @map("skin_id")
  /// slot -> playback options (`soundSlotOptionsSchema`)
  options     Json     @default("{}")
  /// slot -> file URL (public `builtin-*` uploads); slots without one are synthesized
  slots       Json     @default("{}")
  /// slot -> the same, small, for players' devices
  playerSlots Json     @default("{}") @map("player_slots")
  /// unused: the defaults live in the code (`BUILTIN_DEFAULT_OPTIONS`)
  defaults    Json     @default("{}")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("builtin_sound_options")
}
