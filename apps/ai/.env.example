# =============================================================================
# apps/ai — Buzrr-AI (FastAPI + arq worker)
# =============================================================================
# Two processes share this file: the HTTP service and the ingestion worker.
#
#   uvicorn buzrr_ai.main:app --port 3002     # API
#   arq buzrr_ai.worker.WorkerSettings        # worker

# ---- Required ---------------------------------------------------------------

# Same Postgres as the rest of Buzrr. This service owns the `ai` schema only —
# Alembic never touches `public`, Prisma never touches `ai`.
# Production should use a role scoped to the `ai` schema.
AI_DATABASE_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"

# Shared with the Nest server. Job queue + rate limits, all under the `ai:` key
# prefix so nothing collides with the game engine's keyspaces.
REDIS_URL="redis://localhost:6379"

# MUST be identical to apps/web and apps/server. This service verifies the very
# same JWT the Nest server does; a mismatch means every AI call 401s.
BETTER_AUTH_SECRET=""

# Embeddings + generation. Required here (unlike apps/server, where it's optional).
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# CORS allow-list, comma-separated. Unlike the Nest server, an unset value here
# fails closed rather than reflecting every origin.
AI_WEB_ORIGIN="http://localhost:3000"

# ---- Optional ---------------------------------------------------------------

AI_PORT=3002
AI_LOG_LEVEL="INFO"

# AI_EMBEDDING_MODEL="gemini-embedding-001"
# AI_GENERATION_MODEL="gemini-3.5-flash"
# Truncated via MRL and re-normalised. Pinned to the `chunks.embedding` column
# width — changing it needs a migration, so any other value is rejected at boot.
# AI_EMBEDDING_DIMENSIONS=768

# Embedding requests per minute we allow ourselves. One batch of up to 100 chunks
# is one request, so this bounds call frequency, not volume. Sized for a
# free-tier key — raise it a lot on a paid one.
# AI_EMBED_REQUESTS_PER_MINUTE=5

# Concurrent embedding requests. Raise only on a paid key — 1 is what keeps a
# multi-document upload inside a free-tier per-minute quota.
# AI_EMBED_MAX_CONCURRENCY=1

# Upload limits. Enforced server-side; the browser check is only fast feedback.
# AI_MAX_UPLOAD_MB=5
# AI_MAX_FILES=10
# Ephemeral disk. Sources are deleted after successful processing; failures keep
# the file so retry works, and an hourly sweep reaps anything older than 6h.
# AI_TMP_DIR="/tmp/buzrr-ai"

# Chunking. AI_CHUNK_MAX_TOKENS must stay < 2048 (gemini-embedding-001 input cap).
# AI_CHUNK_TARGET_TOKENS=800
# AI_CHUNK_MAX_TOKENS=1800
# AI_CHUNK_OVERLAP_TOKENS=120

# Retrieval. Lower AI_MMR_LAMBDA favours coverage over pure relevance.
# AI_RETRIEVAL_CANDIDATES=40
# AI_RETRIEVAL_FINAL=12
# AI_MMR_LAMBDA=0.6

# Per-user sliding windows (the Nest server rate-limits per IP; cost here is
# attributable to an account).
# AI_RATE_UPLOADS_PER_HOUR=40
# AI_RATE_GENERATIONS_PER_HOUR=30
