# =============================================================================
# apps/server — NestJS API (REST + Socket.IO on a single port)
# =============================================================================
# `yarn setup` generates a working local version of this file automatically.
# Copy to .env and fill in the values below if you set things up by hand.

# ---- Required ---------------------------------------------------------------

# HTTP + Socket.IO port. Must match NEXT_PUBLIC_SOCKET_URL / NEXT_PUBLIC_API_URL
# in apps/web (scheme + host + port only; no /api). API_PORT takes precedence.
PORT=3001

# CORS allow-list for browser clients (REST + Socket.IO). Comma-separated.
# Omit/empty = allow all (dev-friendly).
WEB_ORIGIN="http://localhost:3000"

# Shared Better Auth secret — MUST be identical to apps/web's BETTER_AUTH_SECRET.
# The web app signs JWTs with it; this API verifies them.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# PostgreSQL. Local Docker default shown (see docker-compose.yml).
DATABASE_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"
DIRECT_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"

# Redis-protocol endpoint (live game state + Socket.IO adapter). REQUIRED — the
# realtime engine won't boot without it. Local Docker default shown.
# Managed example (Upstash): rediss://default:<token>@<host>:6379
REDIS_URL="redis://localhost:6379"

# ---- Optional ---------------------------------------------------------------

# AI quiz generation. Without it, only manual quiz creation works.
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Image uploads. Without these, media upload is disabled.
# Sign up: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rate limiting via Upstash REST (only consulted when RATELIMIT=ON in apps/web).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Set to 1/true when running behind a reverse proxy (Render, Fly, etc.).
# TRUST_PROXY=1
