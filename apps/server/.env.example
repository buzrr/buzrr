# =============================================================================
# apps/server — NestJS API (REST + Socket.IO on a single port)
# =============================================================================
# `yarn setup` generates a working local version of this file automatically.
# Copy to .env and fill in the values below if you set things up by hand.

# ---- Required ---------------------------------------------------------------

# HTTP + Socket.IO port. Must match NEXT_PUBLIC_SOCKET_URL / NEXT_PUBLIC_API_URL
# in apps/web (scheme + host + port only; no /api). API_PORT takes precedence.
PORT=3001

# CORS allow-list for browser clients (REST + Socket.IO). Comma-separated.
# Omit/empty = allow all (dev-friendly).
WEB_ORIGIN="http://localhost:3000"

# Shared Better Auth secret — MUST be identical to apps/web's BETTER_AUTH_SECRET.
# The web app signs JWTs with it; this API verifies them.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# PostgreSQL. Local Docker default shown (see docker-compose.yml).
DATABASE_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"
DIRECT_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"

# Redis-protocol endpoint (live game state + Socket.IO adapter). REQUIRED — the
# realtime engine won't boot without it. Local Docker default shown.
# Managed example (Upstash): rediss://default:<token>@<host>:6379
REDIS_URL="redis://localhost:6379"

# ---- Optional ---------------------------------------------------------------

# AI quiz generation (POST /api/quizzes/ai). Without a model configured,
# only manual quiz creation works. Two options:
#
#   Gemini — get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
#   Any OpenAI-compatible server — OpenAI, Ollama, vLLM, LM Studio, LiteLLM…
#   Setting LLM_BASE_URL selects it (or force with LLM_PROVIDER=gemini|openai).
# LLM_BASE_URL="http://localhost:11434/v1"   # Ollama
# LLM_MODEL="llama3.1"                       # required for openai; Gemini defaults to gemini-3.5-flash
# LLM_API_KEY=""                             # optional for local servers

# Question images. STORAGE_DRIVER = cloudinary | s3 | local. Unset: cloudinary
# when CLOUDINARY_CLOUD_NAME is set, otherwise local disk.
# STORAGE_DRIVER="local"
#
#   local — files on this server, served at /uploads. Use a persistent disk.
# STORAGE_LOCAL_DIR="./uploads"
# STORAGE_PUBLIC_URL="http://localhost:3001/uploads"   # how browsers reach them
#
#   cloudinary — https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
#
#   s3 — any S3-compatible store (AWS, Cloudflare R2, Backblaze B2, SeaweedFS,
#   Garage…). Objects must be publicly readable. Only PNG/JPEG/GIF/WebP/AVIF.
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""            # omit for AWS; e.g. https://<acct>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""          # default: <endpoint>/<bucket>
# S3_FORCE_PATH_STYLE=""    # default: true with a custom endpoint
# S3_PREFIX=""              # e.g. "buzrr/"

# Rate limiting via Upstash REST (only consulted when RATELIMIT=ON in apps/web).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Set to 1/true when running behind a reverse proxy (Render, Fly, etc.).
# TRUST_PROXY=1

# ---- Buzrr Pro billing (Dodo Payments) -------------------------------------

# ON enables plans + checkout. Unset/OFF (self-hosting, local dev): no billing,
# every account gets Pro limits. When ON, all four values below are required
# and the server refuses to boot without them.
# BILLING=ON
# test_mode | live_mode. Anything else (or unset) means test_mode.
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Dodo dashboard → Developer → API Keys.
DODO_PAYMENTS_API_KEY=""
# Dodo dashboard → Developer → Webhooks → your endpoint's signing secret (whsec_…).
# MUST match apps/web — both verify the same webhook signature.
DODO_PAYMENTS_WEBHOOK_KEY=""
# The Buzrr Pro monthly subscription product (pdt_…), with an IN/INR localized price.
DODO_PRO_PRODUCT_ID=""
# Public web origin, used for checkout return and billing-portal return URLs.
APP_URL="http://localhost:3000"
# Optional promotion: a Dodo discount code (e.g. LAUNCH20) shown struck-through on
# the pricing pages and applied to checkouts automatically. Its amount, dates and
# redemption limit are read live from Dodo, so ending it there ends it here.
# DODO_PROMO_DISCOUNT_CODE=""

# Set to OFF to stop matching lone 1v1 queuers with a bot after 15s. They then
# wait out the full 60s queue timeout instead. Enabled when unset.
# DUEL_BOTS=OFF
