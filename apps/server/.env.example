# HTTP + Socket.IO (same port). Match NEXT_PUBLIC_SOCKET_URL in apps/web (scheme + host + port only; no /api).
API_PORT=3001
# Or use PORT; API_PORT takes precedence in main.ts

# CORS for REST and Socket.IO browser clients (Next.js dev server or production URL).
# Comma-separated for multiple origins. Omit or empty = allow all in dev-friendly mode.
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=""
DIRECT_URL=""

# Generate via the Better Auth Console
BETTER_AUTH_SECRET=""

# Redis-protocol endpoint (required; live game state + Socket.IO adapter).
# Upstash: rediss://default:<token>@<host>:6379 — or redis://localhost:6379 locally.
REDIS_URL=""

# Upstash REST (optional; rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
