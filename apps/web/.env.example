BETTER_AUTH_URL="http://localhost:[PORT]"
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:[PORT]"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Generate via the Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Generate via the Gemini API Console
GEMINI_API_KEY=""

# Generate via Supabase or any other PostgreSQL database
DATABASE_URL=""
DIRECT_URL=""

# Generate via Upstash
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Base URL of the Nest server (HTTP + Socket.IO). Must match API_PORT/PORT on the server (e.g. http://localhost:3001). No /api suffix.
NEXT_PUBLIC_SOCKET_URL=""

# Same origin as the Nest HTTP server (no /api suffix). Used for REST calls from the browser.
NEXT_PUBLIC_API_URL=""

# Accepted values: ON | OFF
RATELIMIT="OFF"