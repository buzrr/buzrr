# =============================================================================
# apps/web — Next.js app (also hosts Better Auth)
# =============================================================================
# `yarn setup` generates a working local version of this file automatically.
# Copy to .env and fill in the values below if you set things up by hand.

# ---- Required ---------------------------------------------------------------

# Base URL Better Auth runs on (this app).
BETTER_AUTH_URL="http://localhost:3000"

# Origins allowed to call the auth endpoints. Comma-separated.
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Shared Better Auth secret — MUST match apps/server's BETTER_AUTH_SECRET.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Sign-in — at least one method is REQUIRED.
#
# Local accounts (email + password): ON needs nothing outside this server, so
# it is what self-hosted/offline installs use. AUTH_EMAIL_SIGNUP=OFF closes
# self-registration once the accounts you need exist. No email verification
# or password reset — there is no mail server to send from.
AUTH_EMAIL_PASSWORD="ON"
# AUTH_EMAIL_SIGNUP="OFF"
#
# Google OAuth — enabled when both are set. Create credentials at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# PostgreSQL (Better Auth's Prisma adapter connects directly).
# Local Docker default shown (see docker-compose.yml).
DATABASE_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"
DIRECT_URL="postgresql://buzrr:buzrr@localhost:5432/buzrr"

# Where the browser reaches the NestJS API (no /api suffix).
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Where the browser reaches the Buzrr-AI service (no /api suffix).
# Leave unset to hide the AI Spaces section entirely — web + server work fine
# without the Python service running.
NEXT_PUBLIC_AI_API_URL="http://localhost:3002"

# Public base URL of this web app — used to build shareable join links / QR
# codes for hosted quizzes (e.g. https://<app>/join/<CODE>). Falls back to the
# browser's origin when unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Optional ---------------------------------------------------------------

# Dodo Payments webhook signing secret (whsec_…). Only needed when the API runs
# with BILLING=ON. Server-side only — never prefix with NEXT_PUBLIC_. MUST match
# apps/server: /api/webhooks/dodo verifies it, then forwards to the API, which
# verifies again. Register https://<this app>/api/webhooks/dodo in Dodo.
DODO_PAYMENTS_WEBHOOK_KEY=""
# Private origin the webhook forwarder uses to reach the API (no /api suffix).
# Falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL="http://localhost:3001"

# NOTE: GEMINI_API_KEY / LLM_* are NOT read by this app. They are consumed by
# apps/server (POST /api/quizzes/ai) and apps/ai. Set them there, not here.

# Images stored by the API on its own disk (STORAGE_DRIVER=local) are often
# served over plain http on a LAN. NEXT_PUBLIC_API_URL's origin is allowed
# for <Image> automatically; set this if media comes from another http origin
# (e.g. a self-hosted S3 store). Build-time.
# MEDIA_ORIGIN="http://files.school.lan:8333"
# Serve images straight to browsers instead of through Next's optimizer —
# needed when the optimizer can't reach the media URL (the Docker image sets
# it). Build-time.
# NEXT_IMAGE_UNOPTIMIZED="1"

# GitHub API token for landing-page repo stats (stars, commits, PRs, contributors).
# Without it, unauthenticated requests work but are rate-limited (60/hour).
# With a token, the limit rises to 5,000/hour — useful in production / SSR.
#
# Setup:
#   1. https://github.com/settings/tokens → "Generate new token"
#      (Fine-grained or classic; classic with no scopes is enough for public repos)
#   2. Fine-grained: Resource owner = your user/org, Repository access = Public
#      repositories (or only buzrr/buzrr), Permissions → Contents: Read-only
#   3. Paste the token below (never commit it)
GITHUB_TOKEN=""

# MP4 shown on the landing page ("See Buzrr in action"), played as-is — upload
# it at 1080p. Cloudinary URLs also get a first-frame poster. Server-side;
# leave empty to hide the section.
LANDING_VIDEO_URL="https://res.cloudinary.com/dov6iolx4/video/upload/v1791041857/buzrr-reel-60s_qchy3y.mp4"

# Rate limiting: ON | OFF. When ON, the Upstash values below must be set.
RATELIMIT="OFF"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
